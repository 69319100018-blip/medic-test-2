# สำหรับ Vercel: ตั้งใน Project → Settings → Environment Variables
# สำหรับรัน local: คัดลอกไป server-local/.env

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ALLOWED_ORIGINS=https://medic-test-1.vercel.app,http://localhost:3000
PORT=3000

# Discord notifications (server-side only; never prefix these with NEXT_PUBLIC_)
# เข้าเวร/ออกเวร
DISCORD_WEBHOOK_URL=
# ธุรกรรมกองกลางและการเบิก/เติมสต็อก
DISCORD_WEBHOOK_FUND_STOCK=
# เพิ่มทะเบียนรถ
DISCORD_WEBHOOK_VEHICLE=
